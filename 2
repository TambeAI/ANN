import numpy as np 
def mcculloc(x1,x2): 
    w1=1 
    w2=-1 
    theta=1 
    output=[] 
    for i in range(len(x1)): 
             w=np.dot([w1,w2],[x1[i],x2[i]]) 
             output.append(1) if w>=theta else output.append(0)  
    return output  
 
 
n = int(input("How many values do you want to enter? ")) 
x1 = [] 
x2 = [] 
 
print("Enter values for x1:") 
for i in range(n): 
    a = int(input("Enter a number: ")) 
    x1.append(a) 
 
print("Enter values for x2:") 
for i in range(n): 
    b = int(input("Enter a number: ")) 
    x2.append(b) 
 
 
output = mcculloc(x1, x2) 
print("Neuron output:") 
print("\nX1  X2  Y") 
print("-----------") 
for i in range(n): 
    print(x1[i], " ", x2[i], " ", output[i])
