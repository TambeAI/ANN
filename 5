import numpy as np 
x1=np.array([1,1,1]) 
y1=np.array([1,1,-1,-1]) 
x2=np.array([-1,-1,1]) 
y2=np.array([-1,-1,1,1]) 
W1=np.outer(x1,y1)+np.outer(x2,y2) 
print("w=",W1) 
print("\n---------- FORWARD CALL ----------") 
print("INPUT:") 
print("original x1=",x1) 
print("original x2=",x2) 
print("\nOUTPUT:") 
y1=np.sign(np.dot(x1,W1)) 
print("y1=",y1) 
y2=np.sign(np.dot(x2,W1)) 
print("y2=",y2) 
print("\n---------- BACKWARD CALL ----------") 
print("INPUT:") 
print("original y1=",y1) 
print("original y2=",y2) 
print("\nOUTPUT:")
x1=np.dot(y1,W1.T)
x1_o=np.where(x1>=0,1,-1)
print("x1=",x1_o) 
x2=np.dot(y2,W1.T)
x2_o=np.where(x2>=0,1,-1)
print("x2=",x2_o)
